---
import { segments, cases, segmentStrings } from '../data/segments';
import { exhibits, exhibitStrings } from '../data/exhibits';
import { JNJ_PUBLIC } from '../data/disclosure';
import { rosette } from '../lib/guilloche';
import { exhibitSvg } from '../lib/exhibits';
import type { Locale } from '../i18n/strings';

interface Props { locale: Locale }
const { locale } = Astro.props;
const s = segmentStrings[locale];
const xs = exhibitStrings[locale];
const visible = cases.filter((c) => JNJ_PUBLIC || !c.jnj);
const embargoed = cases.length - visible.length;
const ros = rosette(80, 22, 48, 11, 1400);
const folios = new Map(visible.map((c, i) => [c.id, i + 1]));
const groups = segments.map((seg, i) => ({
  seg, i,
  items: visible.filter((c) => c.segment === seg.id),
  embargo: seg.id === 'biz' && embargoed > 0,
}));
/** "97/100" → 97 + "/100"; only figures of two digits or more are worth counting up. */
const countable = (v: string) => {
  const m = v.match(/^(\d+)(.*)$/s);
  return m && +m[1] >= 10 ? { n: m[1], rest: m[2] } : null;
};
const micro = Array.from({ length: 14 }, () => 'SGM · SERIE 0001 · SERIES III · ').join('');
---
<section id="segments" class="seg" aria-labelledby="seg-title" data-segments>
  <header class="wrap seg-head">
    <p class="label kicker">{s.kicker}</p>
    <h2 id="seg-title" data-typeset>{s.title}</h2>
    <p class="lede">{s.lede}</p>
    <ol class="seg-nav" data-seg-nav>
      {groups.map((g) => (
        <li data-nav={g.seg.id}>
          <a href={`#seg-${g.seg.id}`}><span class="label code">{g.seg.code}</span><span class="nm">{g.seg.name[locale]}</span><span class="label n">{s.cases(g.items.length + (g.embargo ? 1 : 0))}</span></a>
        </li>
      ))}
    </ol>
  </header>

  <div class="pin" data-pin>
    <div class="rail" data-rail tabindex="0" aria-label={s.title}>
      <div class="track" data-track>
        {groups.map((g) => (
          <>
            <article class="divider" id={`seg-${g.seg.id}`} data-seg={g.seg.id} data-panel data-divider data-tone="dark" aria-labelledby={`seg-${g.seg.id}-h`}>
              <svg class="d-ros" viewBox="-100 -100 200 200" aria-hidden="true" focusable="false"><path d={ros} /></svg>
              <p class="label d-num">iii.{g.i + 1} · {s.cases(g.items.length + (g.embargo ? 1 : 0))}</p>
              <p class="d-code" aria-hidden="true" data-dcode>{g.seg.code}</p>
              <h3 class="d-name" id={`seg-${g.seg.id}-h`}>{g.seg.name[locale]}</h3>
              <p class="d-thesis">{g.seg.thesis[locale]}</p>
              <div class="d-index">
                <p class="label d-ih">{xs.index}</p>
                <ol>
                  {g.items.map((c) => (
                    <li data-dline><span class="label">{c.id}</span><span class="t">{c.title[locale]}</span><span class="label f">iii·{folios.get(c.id)}</span></li>
                  ))}
                  {g.embargo && <li data-dline class="emb"><span class="label">BIZ</span><span class="t"><span class="bar" aria-hidden="true"></span><span class="sr">{s.embargoTitle}</span></span><span class="label f">—</span></li>}
                </ol>
              </div>
            </article>
            {g.items.map((c) => {
              const folio = folios.get(c.id)!;
              const k = countable(c.kpi.value[locale]);
              const ex = exhibits[c.id];
              const svg = ex ? exhibitSvg(c.id, locale, ex.alt[locale]) : null;
              return (
              <article class="case" data-seg={g.seg.id} data-panel data-case aria-labelledby={`case-${c.id}`}>
                <div class="spread" data-spread>
                  <div class="c-left">
                    <p class="label c-id"><span>Case {c.id}</span><span>{c.context[locale]}</span></p>
                    <h3 id={`case-${c.id}`} class="c-title">{c.title[locale]}</h3>
                    <p class="c-kpi" data-kpi>
                      {k
                        ? <span class="v" data-count={k.n} data-rest={k.rest} data-locale={locale}>{c.kpi.value[locale]}</span>
                        : <span class="v">{c.kpi.value[locale]}</span>}
                      <span class="l">{c.kpi.label[locale]}</span>
                    </p>
                    <div class="c-meta">
                      <p class="label c-stack">{c.stack}</p>
                      <p class="label c-src">
                        <span>[{c.source}]</span>
                        {c.link && <a href={c.link} rel="noopener">{c.link.includes('tryhackme') ? s.profile : s.repo} ↗</a>}
                      </p>
                    </div>
                  </div>
                  <ol class="steps">
                    {[c.problem, c.decision, c.result, c.learning].map((txt, k) => (
                      <li class:list={['step', `k${k}`]} data-step>
                        <span class="bar" aria-hidden="true" data-bar></span>
                        <span class="label st">{String(k + 1).padStart(2, '0')} {s.steps[k]}</span>
                        <p>{txt[locale]}</p>
                      </li>
                    ))}
                  </ol>
                  <p class="label c-folio" aria-hidden="true">iii · {folio}</p>
                </div>
                {svg && (
                  <figure class="plate" data-plate data-tone="dark">
                    <div class="plate-in" data-plate-in>
                      <p class="micro" aria-hidden="true" data-t={micro}></p>
                      <p class="label p-head"><span>{xs.exhibit} {c.id}</span><span aria-hidden="true">{xs.fold} iii·{folio}a</span></p>
                      <Fragment set:html={svg} />
                      <figcaption>{ex.caption[locale]}</figcaption>
                      <p class="micro" aria-hidden="true" data-t={micro}></p>
                      <span class="shade" aria-hidden="true" data-shade></span>
                    </div>
                  </figure>
                )}
              </article>
            ); })}
            {g.embargo && (
              <article class="case embargo" data-seg={g.seg.id} data-panel>
                <div class="spread" data-spread>
                  <div class="c-left">
                    <p class="label c-id"><span>Case BIZ-0{1}–0{embargoed}</span><span>2026</span></p>
                    <h3 class="c-title">{s.embargoTitle}</h3>
                    <p class="e-body">{s.embargoBody}</p>
                  </div>
                  <div class="e-redacted" aria-hidden="true">
                    {Array.from({ length: 7 }, (_, k) => <span data-redact style={`width:${[92, 74, 86, 60, 95, 70, 45][k]}%`}></span>)}
                    <p class="e-stamp" data-stamp>{s.embargoStamp}</p>
                  </div>
                </div>
              </article>
            )}
          </>
        ))}
      </div>
    </div>
    <div class="wrap seg-foot" aria-hidden="true">
      <span class="prog"><span class="prog-fill" data-progress></span></span>
      <span class="label hint"><span class="hint-touch">{s.swipe} →</span><span class="hint-pointer">{s.scrollHint} ↓</span></span>
    </div>
  </div>
</section>

<style>
  .seg { --spread-bg: #f4f3ec; --div-bg: #10201a; --div-fg: #e9e8df;
         --pl-bg: #11221b; --pl-ink: #e9e8df; --pl-soft: #a9b6ab; --pl-ochre: #d4a54a; --pl-red: #ee7b6f; --pl-w: clamp(330px, 32vw, 470px);
         border-top: 1px solid var(--rule); padding-top: 5rem; overflow-x: clip; }
  .seg-head { display: grid; gap: .75rem; }
  .kicker { color: var(--seal); margin: 0; }
  h2 { font-size: var(--step-5); }
  .lede { margin: 0; max-width: var(--measure); color: var(--ink-soft); }
  .seg-nav { list-style: none; margin: 1.5rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--ink); }
  .seg-nav a { display: grid; gap: .2rem; padding: .8rem .8rem .8rem 0; text-decoration: none; border-bottom: 3px solid transparent; transition: border-color .3s; }
  .seg-nav li + li a { padding-left: .8rem; border-left: 1px solid var(--rule); }
  .seg-nav li.on a { border-bottom-color: var(--seal); }
  .seg-nav .code { color: var(--seal); }
  .seg-nav .nm { font-family: var(--font-display); font-size: var(--step-1); line-height: 1.1; }
  .seg-nav .n { color: var(--ink-soft); }
  @media (max-width: 640px) { .seg-nav { grid-template-columns: minmax(0, 1fr); } .seg-nav li + li a { padding-left: 0; border-left: 0; border-top: 1px solid var(--rule); } }

  /* ---------- rail: native horizontal swipe by default; GSAP pins it on wide screens ---------- */
  .pin { padding-top: 2.5rem; }
  .rail { overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory; scrollbar-width: none; padding-bottom: 1rem; }
  .rail::-webkit-scrollbar { display: none; }
  .rail:focus-visible { outline: 2px solid var(--seal); outline-offset: -2px; }
  .track { display: flex; gap: clamp(16px, 2.5vw, 40px); padding-inline: max(16px, env(safe-area-inset-left, 0px)) max(16px, env(safe-area-inset-right, 0px)); width: max-content; align-items: stretch; }
  :global(html.h-pinned) .rail { overflow: visible; scroll-snap-type: none; }
  :global(html.h-pinned) .track { will-change: transform; }

  [data-panel] { scroll-snap-align: center; flex: 0 0 auto; position: relative; }

  /* ---------- divider: dark page, the segment as a cover, with its own table of contents ---------- */
  .divider { width: min(88vw, 520px); min-height: min(76svh, 640px); background: var(--div-bg); color: var(--div-fg); padding: clamp(1.5rem, 3vw, 2.5rem); display: grid; align-content: end; gap: .8rem; overflow: hidden; }
  .divider p { margin: 0; }
  .d-ros { position: absolute; width: 150%; right: -70%; top: -30%; opacity: .5; }
  .d-ros path { fill: none; stroke: #b0852b; stroke-width: .5; vector-effect: non-scaling-stroke; }
  .d-num { position: absolute; top: clamp(1.5rem, 3vw, 2.5rem); left: clamp(1.5rem, 3vw, 2.5rem); color: #e2b8a0; }
  .d-code { font-family: var(--font-display); font-size: clamp(6rem, 18vw, 12rem); line-height: .8; letter-spacing: -.04em; color: transparent; -webkit-text-stroke: 1px rgba(233, 232, 223, .55); }
  .d-code :global(.ch) { display: inline-block; }
  .d-name { font-size: var(--step-3); color: #f3f2ea; }
  .d-thesis { max-width: 30ch; color: #b9c0b6; }
  .d-index { margin-top: .6rem; border-top: 1px solid rgba(233, 232, 223, .3); padding-top: .6rem; }
  .d-ih { color: #e2b8a0; }
  .d-index ol { list-style: none; margin: .4rem 0 0; padding: 0; display: grid; }
  .d-index li { display: grid; grid-template-columns: 4.6rem minmax(0, 1fr) auto; gap: .8rem; align-items: baseline; padding-block: .32rem; border-bottom: 1px dotted rgba(233, 232, 223, .22); font-size: .82rem; line-height: 1.35; }
  .d-index li .label { color: #c9b27e; font-size: .7rem; }
  .d-index li .t { color: #dfe2d8; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .d-index .emb .bar { display: inline-block; width: 70%; height: .8em; background: #050a07; vertical-align: middle; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  /* ---------- case: a two-page spread, and on its right edge a gatefold plate that unfolds ---------- */
  .case { display: flex; align-items: stretch; }
  .spread { position: relative; width: min(88vw, 1120px); min-height: min(76svh, 640px); background: var(--spread-bg); box-shadow: 0 30px 60px -38px rgba(0,0,0,.5); display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); }
  .spread::before { content: ''; position: absolute; top: 0; bottom: 0; left: calc(5 / 12 * 100%); width: 1px; background: var(--rule); }
  .spread::after { content: ''; position: absolute; top: 0; bottom: 0; left: calc(5 / 12 * 100%); width: 40px; transform: translateX(-100%); background: linear-gradient(90deg, transparent, rgba(23,51,38,.06)); pointer-events: none; }
  .c-left { padding: clamp(1.25rem, 3vw, 2.5rem); display: flex; flex-direction: column; gap: 1.1rem; min-width: 0; }
  .c-left p { margin: 0; }
  .c-id { display: flex; flex-wrap: wrap; gap: .3rem 1rem; color: var(--ink-soft); }
  .c-id span:first-child { color: var(--seal); }
  .c-title { font-size: clamp(1.6rem, 1.1rem + 1.8vw, 2.6rem); }
  .c-kpi { display: grid; gap: .2rem; padding-block: 1rem; border-block: 1px solid var(--rule); }
  .c-kpi .v { font-family: var(--font-display); font-size: clamp(3.4rem, 2rem + 5vw, 6.5rem); line-height: .9; letter-spacing: -.02em; color: var(--ink); display: inline-block; transform-origin: left bottom; font-variant-numeric: tabular-nums; }
  .c-kpi .l { color: var(--ink-soft); }
  .c-meta { margin-top: auto; display: grid; gap: .8rem; padding-bottom: 1.2rem; }
  .c-stack { color: var(--ink); line-height: 1.7; }
  .c-src { display: flex; gap: 1rem; color: var(--ink-soft); }
  .c-src a { color: var(--seal); }

  .steps { list-style: none; margin: 0; padding: clamp(1.25rem, 3vw, 2.5rem); display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.75rem 2rem; align-content: center; min-width: 0; }
  .step { position: relative; padding-top: .9rem; display: grid; gap: .5rem; align-content: start; }
  .step p { margin: 0; }
  .bar { position: absolute; top: 0; left: 0; right: 0; height: 2px; background: var(--ink); transform-origin: left center; }
  .st { color: var(--ink-soft); }
  .k2 .bar { background: var(--seal); height: 3px; }
  .k2 .st { color: var(--seal); }
  .k3 p { font-family: var(--font-display); font-size: var(--step-1); line-height: 1.25; }
  .c-folio { position: absolute; right: 1.25rem; bottom: .9rem; color: var(--ink-soft); margin: 0; }

  /* the plate: an intaglio-dark exhibit page hinged to the spread's outer edge */
  .plate { margin: 0; width: var(--pl-w); flex: 0 0 auto; perspective: 1800px; position: relative; z-index: 1; }
  .plate-in { position: relative; height: 100%; background: var(--pl-bg); color: var(--pl-ink); padding: 1rem 1.1rem .9rem; display: flex; flex-direction: column; gap: .5rem;
              transform-origin: 0 50%; backface-visibility: hidden; box-shadow: inset 0 0 0 1px rgba(212,165,74,.35), inset 0 0 0 6px var(--pl-bg), inset 0 0 0 7px rgba(212,165,74,.18); overflow: hidden; }
  .micro { margin: 0; font-size: 5px; line-height: 1; letter-spacing: .25em; white-space: nowrap; overflow: hidden; color: rgba(212,165,74,.55); }
  .micro::before { content: attr(data-t); } /* microprint is ornament: drawn by CSS so it is not read or audited as text */
  .p-head { margin: 0; display: flex; justify-content: space-between; gap: 1rem; color: var(--pl-ochre); }
  .p-head span + span { color: var(--pl-soft); }
  .plate figcaption { font-family: var(--font-display); font-size: clamp(1rem, .7rem + .8vw, 1.25rem); line-height: 1.25; color: #f3f2ea; margin-top: auto; }
  .shade { position: absolute; inset: 0; background: #000; opacity: 0; pointer-events: none; }

  /* exhibit SVG vocabulary */
  .plate :global(.ex) { display: block; width: 100%; height: auto; max-height: 62svh; overflow: visible; fill: var(--pl-ink); }
  .plate :global(.ex text) { font-family: var(--font-mono); fill: var(--pl-ink); }
  .plate :global(.ex .lb) { font-size: 10.5px; letter-spacing: .12em; }
  .plate :global(.ex .tx) { font-size: 11.5px; }
  .plate :global(.ex .mini) { font-size: 9.5px; letter-spacing: .04em; }
  .plate :global(.ex .pre) { white-space: pre; }
  .plate :global(.ex .mid) { text-anchor: middle; }
  .plate :global(.ex .end) { text-anchor: end; }
  .plate :global(.ex .big) { font-family: var(--font-display); font-size: 52px; }
  .plate :global(.ex .num) { font-family: var(--font-display); font-size: 34px; letter-spacing: -.01em; }
  .plate :global(.ex .q) { font-family: var(--font-display); font-size: 18px; fill: var(--pl-red); }
  .plate :global(.ex .soft) { fill: var(--pl-soft); }
  .plate :global(.ex .ochre) { fill: var(--pl-ochre); }
  .plate :global(.ex .red), .plate :global(.ex .red text) { fill: var(--pl-red); }
  .plate :global(.ex rect.soft) { fill: var(--pl-soft); opacity: .6; }
  .plate :global(.ex .dot) { fill: var(--pl-ink); }
  .plate :global(.ex .ochref) { fill: var(--pl-ochre); }
  .plate :global(.ex .bad) { fill: var(--pl-red); }
  .plate :global(.ex .box) { fill: none; stroke: var(--pl-ink); stroke-width: 1; }
  .plate :global(.ex .box.solid) { fill: var(--pl-ink); }
  .plate :global(.ex .inv) { fill: var(--pl-bg); }
  .plate :global(.ex .frame) { fill: none; stroke: rgba(233,232,223,.35); stroke-width: 1; }
  .plate :global(.ex .px) { fill: var(--pl-ink); }
  .plate :global(.ex .px.ochref) { fill: var(--pl-ochre); }
  .plate :global(.ex .scan) { fill: var(--pl-red); }
  .plate :global(.ex .seal) { fill: var(--pl-bg); stroke: var(--pl-red); stroke-width: 1.4; }
  .plate :global(.ex .paper) { fill: #ecebe3; }
  .plate :global(.ex .ink) { fill: #173326; }
  .plate :global(.ex .inkf) { fill: #173326; }
  .plate :global(.ex .paperf) { fill: #ecebe3; }
  .plate :global(.ex .inst) { fill: none; stroke: var(--pl-ink); stroke-width: 1.3; }
  .plate :global(.ex .dash) { stroke: var(--pl-ink); stroke-width: 1.1; stroke-dasharray: 4 4; }
  .plate :global(.ex .dash.ochre) { stroke: var(--pl-ochre); }
  .plate :global(.ex .dash.red) { stroke: var(--pl-red); }
  .plate :global(.ex .x-draw.red) { fill: var(--pl-red); }
  .plate :global(.ex .flagbox) { fill: rgba(238,123,111,.12); stroke: var(--pl-red); stroke-width: 1; }
  .plate :global(.ex .okf) { fill: var(--pl-ochre); }
  .plate :global(.ex .tick) { fill: none; stroke: var(--pl-bg); stroke-width: 2.2; }
  .plate :global(.ex .ln) { stroke: var(--pl-ink); }
  .plate :global(.ex .fill2) { fill: rgba(233,232,223,.16); }
  .plate :global(.ex .inkf2) { fill: rgba(233,232,223,.55); }
  .plate :global(.ex .redf) { fill: var(--pl-red); }
  .plate :global(.ex .lockb) { fill: var(--pl-ochre); }
  .plate :global(.ex .lockl) { fill: none; stroke: var(--pl-ochre); stroke-width: 1.6; }
  .plate :global(.ex .fo) { margin: 0; color: var(--pl-ink); font-family: var(--font-mono); font-size: 10.5px; letter-spacing: .12em; line-height: 1.45; text-transform: none; }

  /* exhibit motion: the drawn state is the default; html.js parks it until the plate is read */
  .plate :global(.ex :is(.x-draw, .x-drawy, .x-pop, .x-fade, .x-rise, .x-out, .x-scan)) {
    transform-box: fill-box; transition: transform .9s cubic-bezier(.2,.75,.15,1) var(--d, 0s), opacity .7s ease var(--d, 0s);
  }
  .plate :global(.ex .x-draw) { transform-origin: 0 50%; }
  .plate :global(.ex .x-drawy) { transform-origin: 50% 100%; }
  .plate :global(.ex .x-pop) { transform-origin: 50% 50%; transition-timing-function: cubic-bezier(.3,1.6,.5,1), ease; transition-duration: .55s, .3s; }
  .plate :global(.ex .x-out) { opacity: 0; transition-duration: .6s; }
  .plate :global(.ex .x-scan) { opacity: 0; transform: translateX(360px); transition: transform 1.9s cubic-bezier(.45,0,.55,1) var(--d, 0s), opacity .4s ease calc(var(--d, 0s) + 1.7s); }
  :global(html.js) .plate:not(.on) :global(.ex .x-draw) { transform: scaleX(0); }
  :global(html.js) .plate:not(.on) :global(.ex .x-drawy) { transform: scaleY(0); }
  :global(html.js) .plate:not(.on) :global(.ex .x-pop) { transform: scale(0); opacity: 0; }
  :global(html.js) .plate:not(.on) :global(.ex .x-fade) { opacity: 0; }
  :global(html.js) .plate:not(.on) :global(.ex .x-rise) { transform: translateY(10px); opacity: 0; }
  :global(html.js) .plate:not(.on) :global(.ex .x-out) { opacity: 1; }
  :global(html.js) .plate:not(.on) :global(.ex .x-scan) { transform: translateX(0); opacity: 1; transition: none; }
  @media (prefers-reduced-motion: reduce) {
    .plate :global(.ex *) { transition: none !important; }
    .plate :global(.ex .x-scan) { opacity: 0 !important; }
  }

  /* pinned spreads must fit a short laptop screen (1366×768, 1280×720): scale type with the viewport height */
  @media (min-width: 901px) and (max-height: 1000px) {
    .pin { padding-top: 1.25rem; }
    .spread { width: min(92vw, 1240px); min-height: min(80svh, 640px); }
    .c-left { gap: .8rem; padding: clamp(1rem, 2.6vh, 2rem) clamp(1.25rem, 2.5vw, 2.25rem); }
    .c-title { font-size: clamp(1.4rem, .6rem + 2.6vh, 2.2rem); }
    .c-kpi { padding-block: .6rem; }
    .c-kpi .v { font-size: clamp(2.8rem, 1rem + 6vh, 5.5rem); }
    .c-stack { line-height: 1.5; }
    .steps { padding: clamp(1rem, 2.6vh, 2rem) clamp(1.25rem, 2.5vw, 2.25rem); gap: clamp(.9rem, 2.4vh, 1.75rem) 1.75rem; }
    .step { padding-top: .7rem; gap: .35rem; }
    .step p { font-size: clamp(.84rem, .42rem + 1.1vh, 1rem); line-height: 1.5; }
    .k3 p { font-size: clamp(1rem, .5rem + 1.3vh, 1.35rem); line-height: 1.2; }
    .divider { min-height: min(80svh, 640px); }
    .d-code { font-size: clamp(5rem, 16vh, 11rem); }
    .plate :global(.ex) { max-height: calc(80svh - 8.5rem); }
  }

  /* phones and tablets: one column; the plate sits between the headline and the four steps */
  @media (max-width: 900px) {
    .case { width: 88vw; flex-direction: column; background: var(--spread-bg); box-shadow: 0 30px 60px -38px rgba(0,0,0,.5); }
    .spread { display: contents; }
    .spread::before, .spread::after { display: none; }
    .c-left { order: 1; }
    .c-meta { margin-top: 0; padding-bottom: 0; }
    .plate { order: 2; width: auto; margin: 0 clamp(1rem, 4vw, 1.5rem); perspective: none; }
    .plate-in { padding: .9rem .9rem .8rem; }
    .plate :global(.ex) { max-height: none; }

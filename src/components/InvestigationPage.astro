---
/**
 * The full featured investigation, on its own page: the scrollytelling, the live model and
 * the business memo. The report links here from its one-screen abstract (section iv).
 */
import Investigation from './Investigation.astro';
import Simulator from './Simulator.astro';
import Footer from './Footer.astro';
import { abstract } from '../data/investigation';
import { cvHref } from '../data/contact';
import type { Locale } from '../i18n/strings';

interface Props { locale: Locale }
const { locale } = Astro.props;
const A = abstract[locale];
const home = `${import.meta.env.BASE_URL}${locale === 'es' ? 'es/' : ''}`;
---
<nav class="back label" aria-label={A.back}>
  <a href={`${home}#investigation`}><span aria-hidden="true">←</span> {A.back}</a>
  <a class="cv" href={cvHref(locale)} download>CV <span aria-hidden="true">↓</span></a>
</nav>
<main id="main">
  <Investigation locale={locale} />
  <Simulator locale={locale} />
  <section class="end" data-tone="dark" aria-labelledby="end-title">
    <div class="wrap">
      <p class="label k">{A.endKicker}</p>
      <h2 id="end-title">{A.endTitle}</h2>
      <p class="acts">
        <a class="act primary" href={`${home}#segments`}>{A.back} →</a>
        <a class="act" href={cvHref(locale)} download>CV ↓</a>
      </p>
    </div>
  </section>
</main>
<Footer locale={locale} slug="investigation/" />

<style>
  .back { position: relative; z-index: 2; display: flex; justify-content: space-between; gap: 1rem; padding: 1rem var(--gutter-r) 1rem var(--gutter); background: #0f1a14; color: #e9e8df; border-bottom: 1px solid rgb(233 232 223 / .18); }
  .back a { color: inherit; text-decoration: none; }
  .back a:hover { color: #e2614c; }
  .back .cv { background: #e9e8df; color: #0f1a14; padding: .1em .5em; }
  .back .cv:hover { background: #e2614c; color: #0f1a14; }
  .end { background: #0f1a14; color: #e9e8df; padding-block: clamp(4rem, 9vw, 6rem); border-top: 1px solid rgb(233 232 223 / .18); }
  .k { color: #e2614c; margin: 0 0 1rem; }
  h2 { font-size: var(--step-3); max-width: 20ch; }
  .acts { display: flex; flex-wrap: wrap; gap: .75rem; margin: 2rem 0 0; }
  .act { font-size: var(--step--1); letter-spacing: .12em; text-transform: uppercase; text-decoration: none; padding: .75rem 1rem; border: 1px solid #e9e8df; color: #e9e8df; line-height: 1; }
  .act:hover { background: #e9e8df; color: #0f1a14; }
  .act.primary { background: #e9e8df; color: #0f1a14; }
  .act.primary:hover { background: #e2614c; border-color: #e2614c; }
</style>

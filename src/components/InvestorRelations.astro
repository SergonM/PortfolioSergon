---
/**
 * Section vii: investor relations. The back page of the report: how to reach the company,
 * the CV as a one-page PDF built from the same data, shareholder information, and the analyst
 * (when its Worker is live). The email address is assembled in the browser; without JS the
 * spelled-out form is shown and no mailto link exists for scrapers.
 */
import Analyst from './Analyst.astro';
import { contact, cvHref } from '../data/contact';
import { ir } from '../data/ir';
import type { Locale } from '../i18n/strings';

interface Props { locale: Locale }
const { locale } = Astro.props;
const T = ir[locale];
const other: Locale = locale === 'en' ? 'es' : 'en';
const e = contact.email;
---
<section id="investor-relations" class="ir-page" aria-labelledby="irp-title">
  <div class="wrap">
    <header class="head">
      <p class="label kicker">{T.kicker}</p>
      <h2 id="irp-title" data-typeset>{T.title}</h2>
      <p class="lede">{T.lede}</p>
    </header>

    <div class="grid">
      <a class="cv" href={cvHref(locale)} download data-reveal>
        <span class="sheet" aria-hidden="true">
          <span class="l1"></span><span class="l2"></span><span class="l3"></span><span class="l2"></span><span class="l3"></span>
          <span class="pdf label">PDF</span>
        </span>
        <span class="cv-t">{T.cv}</span>
        <span class="cv-m label">{T.cvMeta}</span>
        <span class="cv-go" aria-hidden="true">↓</span>
      </a>

      <dl class="channels" data-reveal>
        <div>
          <dt class="label">{T.email}</dt>
          <dd><span data-mail={`${e.user}|${e.domain}|${e.tld}`}>{e.user} [at] {e.domain} [dot] {e.tld}</span></dd>
        </div>
        <div><dt class="label">LinkedIn</dt><dd><a href={contact.linkedin} rel="me">linkedin.com/in/sergonm</a></dd></div>
        <div><dt class="label">GitHub</dt><dd><a href={contact.github} rel="me">github.com/SergonM</a></dd></div>
        <div><dt class="label">TryHackMe</dt><dd><a href={contact.tryhackme} rel="me">tryhackme.com/p/xSergonMx</a></dd></div>
        <div><dt class="label">{T.cvOther}</dt><dd><a href={cvHref(other)} download hreflang={other} lang={other}>{T.cvOtherLink}</a></dd></div>
      </dl>

      <div class="facts" data-reveal>
        <p class="label fh">{T.factsTitle}</p>
        <table>
          <tbody>
            {T.facts.map(([k, v]) => (<tr><th scope="row" class="label">{k}</th><td>{v}</td></tr>))}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <Analyst locale={locale} />
</section>

<script>
  // Put the address together only in a real browser: name|domain|tld → a working mailto.
  document.querySelectorAll<HTMLElement>('[data-mail]').forEach((el) => {
    const [u, d, t] = (el.dataset.mail ?? '').split('|');
    if (!u || !d || !t) return;
    const addr = `${u}@${d}.${t}`;
    const a = document.createElement('a');
    a.href = `mailto:${addr}`;
    a.textContent = addr;
    el.replaceChildren(a);
  });
</script>

<style>
  .ir-page { padding-block: clamp(4rem, 9vw, 7rem) 0; border-top: 1px solid var(--rule); }
  .head { display: grid; gap: 1rem; max-width: 46rem; margin-bottom: clamp(2rem, 5vw, 3.5rem); }
  .kicker { color: var(--seal); margin: 0; }
  h2 { font-size: var(--step-5); line-height: .95; }
  .lede { margin: 0; color: var(--ink-soft); max-width: var(--measure); }

  .grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr) minmax(0, 1fr); gap: clamp(1.5rem, 4vw, 3rem); align-items: start; padding-bottom: clamp(3rem, 7vw, 5rem); }

  /* the CV: a sheet of paper you can pick up */
  .cv { position: relative; display: grid; gap: .5rem; text-decoration: none; background: var(--ink); color: #e9e8df; padding: 1.5rem 1.5rem 1.4rem; }
  .cv:hover { color: #e9e8df; background: var(--seal); }
  .sheet { position: relative; display: grid; gap: 7px; align-content: start; width: 92px; height: 120px; padding: 16px 12px; margin-bottom: .75rem; background: var(--paper);
           box-shadow: 6px 6px 0 rgb(0 0 0 / .25); transform: rotate(-3deg); transition: transform .45s cubic-bezier(.2, .8, .2, 1); }
  .cv:hover .sheet { transform: rotate(0deg) translate3d(0, -6px, 0); }
  .sheet span:not(.pdf) { display: block; height: 3px; background: var(--ink); opacity: .55; }
  .sheet .l1 { width: 70%; height: 6px; opacity: .9; }
  .sheet .l2 { width: 100%; }
  .sheet .l3 { width: 82%; }
  .pdf { position: absolute; right: -10px; bottom: 12px; background: var(--seal); color: #f4f3ec; padding: 3px 6px; letter-spacing: .1em; }
  .cv:hover .pdf { background: var(--ink); }
  .cv-t { font-family: var(--font-display); font-size: var(--step-1); line-height: 1.1; }
  .cv-m { color: #c9d2cb; letter-spacing: .06em; text-transform: none; }
  .cv:hover .cv-m { color: #f4f3ec; }
  .cv-go { position: absolute; right: 1.25rem; top: 1.25rem; font-size: 1.6rem; transition: transform .35s; }
  .cv:hover .cv-go { transform: translate3d(0, 4px, 0); }

  .channels { margin: 0; border-top: 2px solid var(--ink); }
  .channels div { display: grid; grid-template-columns: 7.5rem minmax(0, 1fr); gap: 1rem; padding-block: .8rem; border-bottom: 1px solid var(--rule); align-items: baseline; }
  dt { color: var(--ink-soft); }
  dd { margin: 0; overflow-wrap: anywhere; }

  .fh { margin: 0 0 .5rem; color: var(--seal); }
  table { width: 100%; border-collapse: collapse; border-top: 2px solid var(--ink); }
  th { text-align: left; font-weight: 400; color: var(--ink-soft); padding: .7rem 1rem .7rem 0; vertical-align: baseline; width: 42%; }
  td { padding: .7rem 0; vertical-align: baseline; }
  tr { border-bottom: 1px solid var(--rule); }

  @media (max-width: 960px) {
    .grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    .facts { grid-column: 1 / -1; }
  }
  @media (max-width: 640px) {
    .grid { grid-template-columns: minmax(0, 1fr); }
    .channels div { grid-template-columns: minmax(0, 1fr); gap: .15rem; }
  }
</style>

---
import { ANALYST_URL, analyst } from '../data/analyst';
import type { Locale } from '../i18n/strings';

interface Props { locale: Locale }
const { locale } = Astro.props;
const A = analyst[locale];
const strings = JSON.stringify({ you: A.you, analyst: A.analyst, thinking: A.thinking, busy: A.busy, down: A.down, empty: A.empty });
---
{ANALYST_URL && (
<section id="analyst" class="ir" data-analyst={ANALYST_URL} aria-labelledby="ir-title">
  <div class="wrap">
    <header class="head">
      <p class="label kicker">{A.kicker}</p>
      <h2 id="ir-title" data-typeset>{A.title}</h2>
      <p class="lede">{A.lede}</p>
    </header>

    <div class="call">
      <div class="bar label" aria-hidden="true">
        <span class="live"><i></i> Live</span>
        <span class="wave">{Array.from({ length: 28 }, (_, i) => <i style={`--i:${(i * 7) % 11}`} />)}</span>
        <span>SGM · Q&amp;A · 2026</span>
      </div>

      <ol class="transcript" data-transcript aria-live="polite">
        <li class="turn op">
          <p class="who label">{A.operator}</p>
          <p class="said">{A.opening}</p>
        </li>
      </ol>

      <div class="chips" data-chips>
        {A.suggestions.map((q) => <button type="button" class="chip" data-q={q}>{q}</button>)}
      </div>

      <form class="ask" data-ask>
        <label class="visually-hidden" for={`q-${locale}`}>{A.placeholder}</label>
        <input id={`q-${locale}`} name="q" maxlength="500" autocomplete="off" placeholder={A.placeholder} />
        <button type="submit" class="label">{A.send} ↵</button>
      </form>
    </div>

    <p class="fine">{A.fineprint}</p>
  </div>
  <script type="application/json" data-analyst-strings set:html={strings} />
</section>
)}

<style>
  .ir { border-top: 1px solid var(--rule); padding-block: 6rem; }
  .head { display: grid; gap: .8rem; margin-bottom: 2.5rem; }
  .kicker { color: var(--seal); margin: 0; }
  h2 { font-size: var(--step-5); }
  .lede { margin: 0; max-width: var(--measure); color: var(--ink-soft); }

  .call { border: 1px solid var(--ink); background: #f4f3ec; box-shadow: 0 30px 60px -40px rgba(0,0,0,.45); display: grid; }
  .bar { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: .6rem 1rem; background: var(--ink); color: var(--paper); }
  .live { display: inline-flex; align-items: center; gap: .45rem; color: #ff8f7a; }
  .live i { width: .55rem; height: .55rem; border-radius: 50%; background: #ff8f7a; animation: pulse 1.6s ease-in-out infinite; }
  @keyframes pulse { 50% { opacity: .25; } }

  .transcript { list-style: none; margin: 0; padding: 1.25rem 1rem; display: grid; gap: 1.25rem; max-height: min(62svh, 560px); overflow-y: auto; overscroll-behavior: contain; scroll-behavior: smooth; }
  .transcript :global(.turn) { display: grid; grid-template-columns: 7.5rem minmax(0, 1fr); gap: .3rem 1rem; padding-top: 1rem; border-top: 1px dashed var(--rule); }
  .transcript :global(.turn:first-child) { border-top: 0; padding-top: 0; }
  .transcript :global(.turn p) { margin: 0; }
  .transcript :global(.who) { color: var(--ink-soft); padding-top: .25rem; }
  .transcript :global(.said) { max-width: 70ch; }
  .transcript :global(.op .said) { color: var(--ink-soft); font-style: italic; }
  .transcript :global(.you .who) { color: var(--ink); }
  .transcript :global(.you .said) { font-family: var(--font-display); font-size: var(--step-1); line-height: 1.3; }
  .transcript :global(.an .who) { color: var(--seal); }
  .transcript :global(.src) { display: inline-block; font-size: .7rem; letter-spacing: .08em; color: var(--seal); border: 1px solid var(--seal); padding: .05rem .4rem; margin: 0 .2rem 0 0; vertical-align: .12em; line-height: 1.4; }
  .transcript :global(.cursor) { display: inline-block; width: .55em; height: 1.05em; background: var(--seal); vertical-align: -.15em; margin-left: .1em; animation: pulse 1s steps(1) infinite; }
  .transcript :global(.dots) { color: var(--ink-soft); font-style: italic; }
  .transcript :global(.dots)::after { content: ' …'; animation: pulse 1s steps(1) infinite; }
  .transcript :global(.said.err) { color: var(--seal); }

  .wave { display: inline-flex; align-items: center; gap: 3px; height: 1rem; }
  .wave i { width: 2px; height: 100%; background: var(--paper); opacity: .45; transform: scaleY(.18); transform-origin: center; }
  :global(.speaking) .wave i { opacity: 1; animation: talk .7s ease-in-out infinite alternate; animation-delay: calc(var(--i) * -97ms); }
  @keyframes talk { from { transform: scaleY(.15); } to { transform: scaleY(1); } }

  .chips { display: flex; flex-wrap: wrap; gap: .5rem; padding: 0 1rem 1rem; }
  .chip { font: inherit; font-size: .86rem; padding: .45rem .75rem; border: 1px solid var(--ink); background: transparent; color: var(--ink); cursor: pointer; text-align: left; transition: background .2s, color .2s; }
  .chip:hover, .chip:focus-visible { background: var(--ink); color: var(--paper); }
  .chips[hidden] { display: none; }

  .ask { display: grid; grid-template-columns: minmax(0, 1fr) auto; border-top: 1px solid var(--ink); }
  .ask input { font: inherit; border: 0; background: transparent; padding: 1rem; color: var(--ink); min-width: 0; }
  .ask input::placeholder { color: var(--ink-soft); opacity: .8; }
  .ask input:focus-visible { outline: 2px solid var(--seal); outline-offset: -2px; }
  .ask button { border: 0; border-left: 1px solid var(--ink); background: var(--seal); color: #fff7f2; padding: 0 1.2rem; cursor: pointer; font-family: inherit; }
  .ask button:disabled { opacity: .5; cursor: progress; }
  .fine { font-size: var(--step--1); color: var(--ink-soft); max-width: 90ch; margin: 1rem 0 0; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  @media (max-width: 640px) {
    .transcript :global(.turn) { grid-template-columns: minmax(0, 1fr); }
    .wave { display: none; }
    .ask { grid-template-columns: minmax(0, 1fr); }
    .ask button { border-left: 0; border-top: 1px solid var(--ink); padding: .8rem; }
  }
</style>

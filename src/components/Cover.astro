---
import { rosette } from '../lib/guilloche';
import { strings, type Locale } from '../i18n/strings';

interface Props { locale: Locale }
const t = strings[Astro.props.locale];
const outer = rosette(80, 22, 48, 11);
const inner = rosette(60, 17, 30, 17);
// Plaza de Bolívar, Bogotá. Micro-text repeats it with the integrity vocabulary.
const micro = Array(6).fill('SGM · INTEGRITY · TRACEABILITY · EVIDENCE · SHA-256 · 4.5981N 74.0760W · ').join('');
---
<header class="cover" aria-labelledby="cover-title">
  <div class="frame" aria-hidden="true"></div>
  <p class="serial label"><span>Nº SGM 2026 0001</span><span>Serie AR</span></p>

  <svg class="rosette" viewBox="-100 -100 200 200" aria-hidden="true" focusable="false">
    <path d={outer} class="r1" />
    <path d={inner} class="r2" />
  </svg>

  <div class="titles">
    <h1 id="cover-title">{t.company}</h1>
    <p class="report label">{t.report}</p>
    <p class="tagline">{t.tagline}</p>
  </div>

  <p class="seal label" aria-hidden="true"><span>{t.seal} ✓</span></p>
  <p class="micro" aria-hidden="true">{micro}</p>
</header>

<style>
  .cover {
    position: relative;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto auto;
    gap: 1.5rem;
    min-height: min(100svh, 980px);
    padding-block: calc(env(safe-area-inset-top, 0px) + 2rem) 2rem;
    padding-left: var(--gutter);
    padding-right: var(--gutter-r);
    overflow: hidden;
    isolation: isolate;
  }
  .frame { position: absolute; inset: 12px; border: 1px solid var(--ink); pointer-events: none; }
  .frame::after { content: ''; position: absolute; inset: 5px; border: 0.5px solid var(--ink); }
  .serial { display: flex; justify-content: space-between; color: var(--seal); margin: 0; padding: 0.75rem 0.75rem 0; }

  .rosette { width: min(88vw, 62svh, 560px); justify-self: center; align-self: center; z-index: -1;
    animation: rosette-in 1.4s cubic-bezier(.2,.7,.2,1) both; }
  .rosette path { fill: none; stroke-width: 0.55; vector-effect: non-scaling-stroke; }
  .r1 { stroke: var(--ink); opacity: 0.75; }
  .r2 { stroke: var(--ochre-line); opacity: 0.9; }

  .titles { text-align: center; display: grid; gap: 0.6rem; justify-items: center; }
  h1 { font-size: var(--step-5); letter-spacing: -0.01em; }
  .report { margin: 0; letter-spacing: 0.32em; }
  .tagline { margin: 0.4rem 0 0; max-width: 40ch; color: var(--ink-soft); font-size: var(--step--1); }

  .seal {
    position: absolute; right: clamp(24px, 9vw, 120px); top: 58%;
    width: clamp(96px, 20vw, 150px); aspect-ratio: 1; margin: 0;
    display: grid; place-items: center; color: var(--seal);
    border: 1.5px solid var(--seal); border-radius: 50%;
    transform: rotate(-14deg);
    animation: stamp 0.45s 1.1s cubic-bezier(.3,1.6,.5,1) both;
  }
  .seal span { font-size: clamp(9px, 2.1vw, 13px); letter-spacing: 0.1em; white-space: nowrap; }
  .seal::before { content: ''; position: absolute; inset: 5px; border: 0.5px solid var(--seal); border-radius: 50%; }
  .micro { margin: 0; font-size: 7px; letter-spacing: 0.06em; white-space: nowrap; overflow: hidden; opacity: 0.7; padding-inline: 0.75rem; }

  @keyframes rosette-in { from { opacity: 0; transform: scale(0.92) rotate(-8deg); } to { opacity: 1; transform: none; } }
  @keyframes stamp { from { opacity: 0; transform: rotate(-14deg) scale(2.2); } to { opacity: 1; transform: rotate(-14deg) scale(1); } }
</style>

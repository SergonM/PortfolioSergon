---
import { createHash } from 'node:crypto';
import { auditor } from '../data/auditor';
import { FLAG_1 } from '../data/audit';
import { ANALYST_URL } from '../data/analyst';
import { rosette } from '../lib/guilloche';
import type { Locale } from '../i18n/strings';

interface Props { locale: Locale }
const { locale } = Astro.props;
const A = auditor[locale];
// The page only carries the hash of paper 1. Papers 2 and 3 are checked by the Worker.
const flag1 = createHash('sha256').update(FLAG_1).digest('hex');
const server = ANALYST_URL ? new URL(ANALYST_URL).origin : '';
const seal = rosette(46, 13, 22, 13, 700);
const roman = ['i', 'ii', 'iii'];
const strings = JSON.stringify({ msg: A.msg, signed1: A.signed1, signErr: A.signErr, hallEmpty: A.hallEmpty, hallClosed: A.hallClosed });
---
<section id="auditor" class="aud" aria-labelledby="aud-title" data-auditor={server} data-f1={flag1}>
  <div class="wrap grid">
    <div class="report">
      <p class="label kicker">{A.kicker}</p>
      <h2 id="aud-title" data-typeset>{A.title}</h2>

      <div class="opinion">
        <p class="label tag">{A.opinionLabel}</p>
        {A.opinion.map((p) => <p>{p}</p>)}
        <p class="verdict"><span>{A.verdict}</span></p>
        <p class="label signed">{A.signed}</p>
      </div>

      <details class="stride">
        <summary class="label"><span>{A.strideSummary}</span><i aria-hidden="true">+</i></summary>
        <table>
          <thead>
            <tr><th scope="col"><span class="visually-hidden">STRIDE</span></th>{A.strideHead.map((h) => <th scope="col" class="label">{h}</th>)}</tr>
          </thead>
          <tbody>
            {A.stride.map((r) => (
              <tr>
                <th scope="row"><b aria-hidden="true">{r.letter}</b><span class="label">{r.name}</span></th>
                <td>{r.threat}</td>
                <td>{r.control}</td>
                <td class="res"><small>{A.strideHead[2]}</small>{r.residual}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="limit">{A.limitation}</p>
      </details>
    </div>

    <aside class="ctf" aria-labelledby="ctf-title">
      <p class="label kicker">{A.ctfKicker}</p>
      <h3 id="ctf-title">{A.ctfTitle}</h3>
      <p class="lede">{A.ctfLede}</p>

      <ol class="seals">
        {A.seals.map((s, i) => (
          <li class="seal" data-seal={i + 1}>
            <svg viewBox="0 0 100 100" aria-hidden="true" focusable="false">
              <circle cx="50" cy="50" r="47" class="ring" />
              <path d={seal} transform="translate(50 50) scale(.62)" class="rose" />
              <circle cx="50" cy="50" r="14" class="hub" />
              <text x="50" y="57" text-anchor="middle" class="num">{roman[i]}</text>
            </svg>
            <span class="label">{s}</span>
            <span class="visually-hidden state" data-seal-state>—</span>
          </li>
        ))}
      </ol>

      <form class="submit" data-verify hidden>
        <label class="label" for={`flag-${locale}`}>{A.inputLabel}</label>
        <div class="row">
          <input id={`flag-${locale}`} name="flag" maxlength="80" autocomplete="off" spellcheck="false" placeholder={A.placeholder} />
          <button type="submit" class="label">{A.verify}</button>
        </div>
      </form>

      <form class="submit sign" data-sign hidden>
        <label class="label" for={`sign-${locale}`}>{A.signLabel}</label>
        <div class="row">
          <input id={`sign-${locale}`} name="name" maxlength="24" autocomplete="nickname" placeholder={A.signPlaceholder} />
          <button type="submit" class="label">{A.sign}</button>
        </div>
      </form>

      <p class="msg" data-msg role="status" aria-live="polite"></p>
      <noscript><p class="msg">{A.noscript}</p></noscript>

      <div id="auditor-hall" class="hall">
        <p class="label">{A.hallTitle}</p>
        <ol data-hall><li class="empty">{server ? A.hallEmpty : A.hallClosed}</li></ol>
      </div>
    </aside>
  </div>
  <script type="application/json" data-auditor-strings set:html={strings} />
</section>

<style>
  .aud { border-top: 1px solid var(--rule); padding-block: 5rem; }
  .grid { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); gap: clamp(2rem, 5vw, 5rem); align-items: start; }
  @media (max-width: 860px) { .grid { grid-template-columns: 1fr; } }
  .kicker { color: var(--seal); margin: 0 0 .8rem; }
  h2 { font-size: var(--step-3); max-width: 16ch; }

  .opinion { margin-top: 2rem; padding-left: 1.25rem; border-left: 2px solid var(--ink); font-family: 'Newsreader', Georgia, serif; font-size: var(--step-1); line-height: 1.45; max-width: 46ch; }
  .opinion p { margin: 0 0 .8rem; }
  .opinion .tag, .opinion .signed { font-family: var(--font-mono); font-size: var(--step--1); color: var(--ink-soft); }
  .verdict span { font-style: italic; color: var(--seal); }

  .stride { margin-top: 2.25rem; border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
  .stride summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; gap: 1rem; padding: 1rem 0; min-height: 44px; align-items: center; }
  .stride summary::-webkit-details-marker { display: none; }
  .stride summary i { font-style: normal; font-size: 1.3rem; transition: transform .3s ease; }
  .stride[open] summary i { transform: rotate(45deg); }
  table { width: 100%; border-collapse: collapse; font-size: .86rem; line-height: 1.45; }
  thead th { text-align: left; color: var(--ink-soft); font-weight: 400; padding: .4rem .6rem .6rem 0; border-bottom: 1px solid var(--ink); }
  tbody th, td { text-align: left; vertical-align: top; padding: .8rem .8rem .8rem 0; border-bottom: 1px solid var(--rule); font-weight: 400; }
  tbody th { white-space: nowrap; }
  tbody th b { display: block; font-family: var(--font-display); font-weight: 400; font-size: 2rem; line-height: 1; color: var(--seal); }
  tbody th .label { font-size: .64rem; color: var(--ink-soft); }
  td.res { color: var(--ink-soft); }
  .limit { font-size: .8rem; color: var(--ink-soft); margin: 1rem 0 1.2rem; max-width: 70ch; }
  /* one threat per row, read top to bottom: what could go wrong, the control, what is left */
  thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  tbody tr { display: grid; grid-template-columns: 3.4rem 1fr; column-gap: 1rem; padding: 1rem 0; border-bottom: 1px solid var(--rule); }
  tbody th { grid-row: span 3; border: 0; padding: 0; white-space: normal; }
  tbody th .label { display: none; }
  td { border: 0; padding: 0 0 .35rem; }
  td:nth-of-type(1) { font-weight: 500; }
  td.res small { font-size: .64rem; letter-spacing: .14em; text-transform: uppercase; margin-right: .5rem; color: var(--seal); }

  .ctf { background: var(--ink); color: var(--paper); padding: clamp(1.25rem, 3vw, 2rem); position: relative; }
  .ctf .kicker { color: #ff9b8a; }
  .ctf h3 { font-size: var(--step-1); line-height: 1.2; }
  .ctf .lede { color: #c9d1c8; font-size: .9rem; margin: .8rem 0 1.5rem; }
  .seals { list-style: none; margin: 0 0 1.5rem; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: .75rem; }
  .seal { display: grid; justify-items: center; gap: .4rem; text-align: center; }
  .seal .label { font-size: .62rem; color: #c9d1c8; }
  .seal svg { width: 100%; max-width: 92px; overflow: visible; }
  .seal .ring { fill: none; stroke: rgb(236 235 227 / .45); stroke-width: 1.2; stroke-dasharray: 3 4; }
  .seal .rose { fill: none; stroke: rgb(236 235 227 / .18); stroke-width: 1.4; }
  .seal .hub { fill: var(--ink); }
  .seal .num { font-family: var(--font-display); font-size: 22px; fill: rgb(236 235 227 / .6); }
  .seal svg { transition: transform .5s cubic-bezier(.2, 1.6, .4, 1), opacity .3s; }
  .seal.found .ring { stroke: #ff9b8a; stroke-dasharray: none; stroke-width: 2.4; }
  .seal.found .rose { stroke: #ff9b8a; }
  .seal.found .num { fill: #ff9b8a; }
  .seal.found .label { color: var(--paper); }
  .seal.stamp svg { animation: stamp .55s cubic-bezier(.2, 1.4, .4, 1) both; }
  @keyframes stamp { 0% { transform: scale(2.2) rotate(-25deg); opacity: 0; } 100% { transform: scale(1) rotate(-8deg); opacity: 1; } }
  .seal.found svg { transform: rotate(-8deg); }

  .submit { display: grid; gap: .45rem; margin-bottom: .75rem; }
  .submit[hidden] { display: none; }
  .submit .label { font-size: .68rem; color: #c9d1c8; }
  .row { display: flex; border: 1px solid rgb(236 235 227 / .5); }
  .row input { flex: 1; min-width: 0; background: transparent; border: 0; color: var(--paper); font: inherit; font-size: 1rem; padding: .7rem .8rem; min-height: 44px; }
  .row input::placeholder { color: rgb(236 235 227 / .5); }
  .row input:focus-visible { outline: 2px solid #ff9b8a; outline-offset: -2px; }
  .submit .row button { border: 0; background: var(--paper); color: var(--ink); padding: 0 1rem; cursor: pointer; min-height: 44px; }
  .submit .row button:hover { background: #ff9b8a; }
  .ctf :focus-visible { outline-color: #ff9b8a; }
  .msg { min-height: 1.6em; font-size: .85rem; color: #ff9b8a; margin: 0 0 1rem; }

  .hall { border-top: 1px solid rgb(236 235 227 / .25); padding-top: 1rem; }
  .hall .label { font-size: .68rem; color: #c9d1c8; margin: 0 0 .5rem; }
  .hall ol { margin: 0; padding: 0; list-style: none; counter-reset: a; font-size: .85rem; display: grid; gap: .25rem; max-height: 12rem; overflow: auto; }
  /* rows are written by the script, so they carry no scoped attribute */
  .hall ol :global(li:not(.empty)) { counter-increment: a; display: flex; justify-content: space-between; gap: 1rem; border-bottom: 1px dotted rgb(236 235 227 / .25); }
  .hall ol :global(li:not(.empty)::before) { content: counter(a, decimal-leading-zero); color: #ff9b8a; margin-right: .6rem; }
  .hall ol :global(span) { flex: 1; overflow-wrap: anywhere; }
  .hall ol :global(time) { color: #c9d1c8; }
  .hall ol :global(.empty) { color: #c9d1c8; font-style: italic; }

  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  @media (prefers-reduced-motion: reduce) { .seal.stamp svg { animation: none; } .stride summary i { transition: none; } }
</style>

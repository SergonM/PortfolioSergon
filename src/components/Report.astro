---
/**
 * The report, in reading order. Both editions (EN at /, ES at /es/) render this.
 * To add a section, import it here and add its id to `present` so Contents links it.
 */
import Hero from './Hero.astro';
import Contents from './Contents.astro';
import Letter from './Letter.astro';
import Highlights from './Highlights.astro';
import Segments from './Segments.astro';
import InvestigationAbstract from './InvestigationAbstract.astro';
import RiskFactors from './RiskFactors.astro';
import InvestorRelations from './InvestorRelations.astro';
import Footer from './Footer.astro';
import type { Locale } from '../i18n/strings';

interface Props { locale: Locale }
const { locale } = Astro.props;
const present = ['letter', 'highlights', 'segments', 'investigation', 'risk-factors', 'investor-relations'];
---
<Hero locale={locale} />
<main id="main">
  <Contents locale={locale} present={present} />
  <Letter locale={locale} />
  <Highlights locale={locale} />
  <Segments locale={locale} />
  <InvestigationAbstract locale={locale} />
  <RiskFactors locale={locale} />
  <InvestorRelations locale={locale} />
</main>
<Footer locale={locale} />

---
import type { Locale } from '../i18n/strings';

interface Props { locale: Locale }
const { locale } = Astro.props;

// The trained tree is optional at build time: until ml/train.py has run on DANE data, the simulator is not rendered.
const found = import.meta.glob('../data/bpn-tree.json', { eager: true, import: 'default' });
const model = Object.values(found)[0] as any;

const T = {
  en: {
    kicker: 'Try it yourself', title: 'What if…?',
    lede: 'Pick a mother’s situation. The tree finds the group of real births that matches it and tells you how many of those babies were born under 2,500 grams.',
    form: 'Birth certificate · simulation', of100: 'of every 100 babies', inGroup: 'born under 2,500 g in this group',
    national: 'Country average', path: 'What the tree looked at', births: 'births in this group',
    fields: { age: 'Mother’s age', edu: 'Mother’s schooling', visits: 'Prenatal check-ups', insurance: 'Health insurance', area: 'Where she lives', multiple: 'Babies', children: 'This child is her…' },
    honest: (m: any) => `This describes groups, it doesn’t predict a person. Trained on ${m.births.toLocaleString('en-US')} DANE births from ${m.years.join(', ')}; on births it never saw, the tree ranks groups better than chance (AUC ${m.metrics.auc.toFixed(2)}, where 0.5 is a coin toss and 1 is perfect). Gestation weeks are left out on purpose: they explain most cases but nobody chooses them. Every group holds at least ${m.params.min_samples_leaf.toLocaleString('en-US')} births.`,
    reset: 'Reset',
  },
  es: {
    kicker: 'Pruébalo tú', title: '¿Y si…?',
    lede: 'Elige la situación de una madre. El árbol encuentra el grupo de nacimientos reales que se parece y te dice cuántos de esos bebés nacieron con menos de 2.500 gramos.',
    form: 'Certificado de nacido vivo · simulación', of100: 'de cada 100 bebés', inGroup: 'nacieron con menos de 2.500 g en este grupo',
    national: 'Promedio del país', path: 'Lo que miró el árbol', births: 'nacimientos en este grupo',
    fields: { age: 'Edad de la madre', edu: 'Estudios de la madre', visits: 'Controles prenatales', insurance: 'Afiliación a salud', area: 'Dónde vive', multiple: 'Bebés', children: 'Este hijo es su…' },
    honest: (m: any) => `Esto describe grupos, no predice a una persona. Entrenado con ${m.births.toLocaleString('es-CO')} nacimientos del DANE de ${m.years.join(', ')}; con nacimientos que nunca vio, el árbol ordena los grupos mejor que el azar (AUC ${m.metrics.auc.toFixed(2).replace('.', ',')}, donde 0,5 es lanzar una moneda y 1 es perfecto). Las semanas de gestación quedan fuera a propósito: explican la mayoría de casos pero nadie las elige. Cada grupo tiene al menos ${m.params.min_samples_leaf.toLocaleString('es-CO')} nacimientos.`,
    reset: 'Reiniciar',
  },
}[locale];

// Default scenario: the most common answer for each field is not known here, so start mid-scale.
const defaults: Record<string, number> = { age: 2, edu: 2, visits: 3, insurance: 0, area: 0, multiple: 0, children: 0 };
const base = model ? Math.round(model.base_rate * 100) : 0;
const payload = model ? JSON.stringify({ columns: model.columns, nodes: model.nodes, features: model.features.map((f: any) => ({ key: f.key, kind: f.kind, labels: f.labels[locale] })), labels: T.fields, base: model.base_rate, locale }) : '';
---
{model && (
<section class="sim" id="simulator" data-sim aria-labelledby="sim-title">
  <div class="wrap grid">
    <header class="head">
      <p class="label kicker">{T.kicker}</p>
      <h2 id="sim-title">{T.title}</h2>
      <p class="lede">{T.lede}</p>
    </header>

    <form class="cert" data-sim-form>
      <p class="label ftitle">{T.form}</p>
      {model.features.map((f: any) => (
        <fieldset>
          <legend class="label">{(T.fields as any)[f.key]}</legend>
          <div class="chips">
            {f.labels[locale].map((l: string, k: number) => (
              <label><input type="radio" name={f.key} value={k} checked={k === (defaults[f.key] ?? 0)} /><span>{l}</span></label>
            ))}
          </div>
        </fieldset>
      ))}
      <button type="reset" class="label reset">{T.reset}</button>
      <p class="peek" aria-hidden="true"><b data-sim-peek>{base}</b> {T.of100}</p>
    </form>

    <div class="result" aria-live="polite">
      <p class="big"><span data-sim-n>{base}</span></p>
      <p class="of">{T.of100}<br /><span>{T.inGroup}</span></p>
      <div class="dots" aria-hidden="true" data-sim-dots>
        {Array.from({ length: 100 }, (_, i) => <i style={`--i:${i}`} class:list={{ on: i < base }} />)}
      </div>
      <p class="label nat">{T.national}: <strong>{base}</strong> / 100 · <span data-sim-births></span> {T.births}</p>
      <div class="path">
        <p class="label">{T.path}</p>
        <ol data-sim-path></ol>
      </div>
    </div>

    <p class="honest">{T.honest(model)} <span class="label">[PRJ-NEO] · DANE</span></p>
  </div>
  <script type="application/json" data-sim-model set:html={payload} />
</section>
)}

<style>
  .sim { --bg: #10201a; --fg: #e9e8df; --soft: #a9b7ad; --red: #e2614c; background: var(--bg); color: var(--fg); padding-block: 2rem 6rem; }
  .grid { display: grid; gap: 2rem; grid-template-columns: minmax(0, 1fr); }
  .head { display: grid; gap: .8rem; }
  .kicker { color: var(--red); margin: 0; }
  h2 { font-size: var(--step-5); color: #f3f2ea; }
  .lede { margin: 0; max-width: var(--measure); color: #d4d8cf; }

  .cert { background: var(--paper); color: var(--ink); padding: 1.25rem; display: grid; gap: 1rem; position: relative;
          border: 1px solid var(--ink); outline: 1px solid var(--ink); outline-offset: -7px; box-shadow: 0 30px 60px -30px rgba(0,0,0,.7); }
  .ftitle { color: var(--seal); margin: 0; }
  fieldset { border: 0; border-top: 1px solid var(--rule); margin: 0; padding: .7rem 0 0; display: grid; gap: .5rem; }
  legend { float: left; width: 100%; color: var(--ink-soft); padding: 0; margin-bottom: .45rem; }
  .chips { display: flex; flex-wrap: wrap; gap: .4rem; }
  .chips label { position: relative; }
  .chips input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .chips span { display: inline-block; padding: .4rem .7rem; border: 1px solid var(--ink); font-size: .86rem; line-height: 1.2; transition: background .2s, color .2s; }
  .chips input:checked + span { background: var(--ink); color: var(--paper); }
  .chips input:focus-visible + span { outline: 2px solid var(--seal); outline-offset: 2px; }
  .reset { justify-self: start; background: none; border: 0; border-bottom: 1px solid var(--seal); color: var(--seal); padding: .2rem 0; cursor: pointer; font-family: inherit; }

  .result { display: grid; gap: .9rem; align-content: start; }
  .big { margin: 0; font-family: var(--font-display); font-size: clamp(6rem, 4rem + 10vw, 11rem); line-height: .85; color: var(--red); }
  .big span { display: inline-block; }
  .of { margin: 0; font-family: var(--font-display); font-size: var(--step-1); color: #f3f2ea; }
  .of span { font-family: var(--font-mono); font-size: var(--step--1); color: var(--soft); }
  .dots { display: grid; grid-template-columns: repeat(20, 1fr); gap: 5px; max-width: 420px; }
  .dots i { aspect-ratio: 1; border-radius: 50%; border: 1px solid rgba(233, 232, 223, .35); transition: background .3s, border-color .3s, transform .3s; transition-delay: calc(var(--i) * 6ms); }
  .dots i.on { background: var(--red); border-color: var(--red); }
  .nat { color: var(--soft); margin: 0; }
  .nat strong { color: var(--fg); font-weight: 400; }
  .path p { margin: 0 0 .4rem; color: var(--soft); }
  .path ol { margin: 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: .3rem .5rem; align-items: center; }
  .path :global(li) { font-size: .86rem; border: 1px solid rgba(233, 232, 223, .3); padding: .25rem .55rem; }
  .path :global(li + li)::before { content: '→'; margin: 0 .5rem 0 -.25rem; color: var(--red); }
  .honest { font-size: var(--step--1); color: var(--soft); max-width: 90ch; margin: 0; border-top: 1px dashed rgba(233, 232, 223, .25); padding-top: 1rem; }
  .honest span { color: var(--fg); }

  .peek { position: sticky; bottom: .75rem; margin: 0 -.5rem; padding: .6rem .9rem; background: var(--ink); color: var(--paper); display: flex; align-items: baseline; gap: .6rem; box-shadow: 0 10px 30px -10px rgba(0,0,0,.6); }
  .peek b { font-family: var(--font-display); font-weight: 400; font-size: 2rem; line-height: 1; color: #ff8f7a; }

  @media (min-width: 901px) {
    .peek { display: none; }
    .grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); column-gap: 3rem; }
    .head, .honest { grid-column: 1 / -1; }
    .result { position: sticky; top: 2rem; }
  }
</style>

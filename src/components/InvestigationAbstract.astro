---
/**
 * Section iv on the report: the investigation in one screen. A recruiter gets the question,
 * the headline number and three findings; the full scrollytelling, the live model and the
 * business memo live on their own page, one tap away.
 */
import { inv, abstract } from '../data/investigation';
import agg from '../data/bpn-aggregates.json';
import tree from '../data/bpn-tree.json';
import { rosette } from '../lib/guilloche';
import type { Locale } from '../i18n/strings';

interface Props { locale: Locale }
const { locale } = Astro.props;
const A = abstract[locale];
const nf = (n: number) => n.toLocaleString(locale === 'es' ? 'es-CO' : 'en-US');
const fill = (s: string) => s
  .replace('{births}', nf(tree.births))
  .replace('{top}', String(Math.round(tree.metrics.top_fifth_rate * 100)))
  .replace('{bottom}', String(Math.round(tree.metrics.bottom_fifth_rate * 100)));
const href = `${import.meta.env.BASE_URL}${locale === 'es' ? 'es/' : ''}investigation/`;
const ros = rosette(96, 37, 70, 37, 1100);
---
<section id="investigation" class="abs" data-tone="dark" aria-labelledby="abs-title">
  <svg class="ros" viewBox="-200 -200 400 400" aria-hidden="true" focusable="false"><path d={ros} /></svg>
  <div class="wrap grid">
    <header class="head">
      <p class="label kicker">{inv.kicker[locale]}</p>
      <h2 id="abs-title" data-typeset>{inv.title[locale]}</h2>
      <p class="label byline">{inv.byline[locale]}</p>
    </header>

    <p class="cold" data-reveal>
      <span class="cn">{nf(agg.cases)}</span>
      <span class="cc">{inv.cold[locale]}</span>
    </p>

    <ol class="finds">
      {A.findings.map((f, i) => (
        <li data-reveal>
          <span class="label n">0{i + 1}</span>
          <p class="t">{fill(f.t)}</p>
          <p class="label note">{fill(f.n)}</p>
        </li>
      ))}
    </ol>

    <div class="go">
      <a class="read" href={href}>
        <span class="r1">{A.read}</span>
        <span class="r2 label">{A.readMeta}</span>
        <span class="arrow" aria-hidden="true">→</span>
      </a>
      <a class="skip-on label" href="#risk-factors">{A.skip} ↓</a>
    </div>
  </div>
</section>

<style>
  .abs { position: relative; overflow: hidden; background: #0f1a14; color: #e9e8df; padding-block: clamp(4rem, 9vw, 7rem); }
  .ros { position: absolute; width: min(70vw, 640px); right: -18%; top: -10%; fill: none; stroke: #e2614c; stroke-width: .35; opacity: .22; pointer-events: none; }
  .grid { position: relative; display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: clamp(2rem, 5vw, 4rem) clamp(2rem, 6vw, 5rem); align-items: end; }
  .kicker { color: #e2614c; margin: 0 0 1rem; }
  h2 { font-size: var(--step-5); line-height: .98; }
  .byline { margin: 1.25rem 0 0; color: #a9b7ad; }
  .cold { margin: 0; display: grid; gap: .5rem; border-top: 1px solid rgb(233 232 223 / .2); padding-top: 1.25rem; }
  .cn { font-family: var(--font-display); font-size: clamp(4rem, 2.5rem + 7vw, 8rem); line-height: .9; color: #e2614c; letter-spacing: -.02em; font-variant-numeric: tabular-nums; }
  .cc { font-family: var(--font-display); font-size: var(--step-1); line-height: 1.2; max-width: 26ch; }
  .finds { grid-column: 1 / -1; list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 2px solid #e9e8df; }
  .finds li { padding: 1.25rem 1.5rem 1.5rem 0; display: grid; align-content: start; gap: .6rem; }
  .finds li + li { padding-left: 1.5rem; border-left: 1px solid rgb(233 232 223 / .2); }
  .n { color: #e2614c; }
  .t { margin: 0; font-family: var(--font-display); font-size: var(--step-1); line-height: 1.22; }
  .note { margin: 0; color: #a9b7ad; letter-spacing: .06em; text-transform: none; line-height: 1.5; }
  .go { grid-column: 1 / -1; display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 2rem; }
  .read { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: .2rem 2rem; align-items: center; text-decoration: none;
          background: #e9e8df; color: #0f1a14; padding: 1.1rem 1.4rem; min-width: min(100%, 34rem); transition: background-color .25s; }
  .read:hover { background: #e2614c; color: #0f1a14; }
  .r1 { font-family: var(--font-display); font-size: var(--step-1); line-height: 1.1; }
  .r2 { grid-row: 2; color: #3e5649; letter-spacing: .08em; }
  .read:hover .r2 { color: #0f1a14; }
  .arrow { grid-row: 1 / span 2; grid-column: 2; font-size: 1.8rem; transition: transform .35s cubic-bezier(.2, .8, .2, 1); }
  .read:hover .arrow { transform: translate3d(.4rem, 0, 0); }
  .skip-on { color: #a9b7ad; }
  .skip-on:hover { color: #e9e8df; }
  @media (max-width: 820px) {
    .grid { grid-template-columns: minmax(0, 1fr); }
    .finds { grid-template-columns: minmax(0, 1fr); }
    .finds li, .finds li + li { padding: 1.1rem 0; border-left: 0; }
    .finds li + li { border-top: 1px solid rgb(233 232 223 / .2); }
    .ros { width: 120vw; right: -60%; top: -5%; }
  }
</style>

---
import '@fontsource/gloock/400.css';
import '@fontsource/dm-mono/400.css';
import '@fontsource/dm-mono/500.css';
import '../styles/global.css';
import RunningHead from '../components/chrome/RunningHead.astro';
import { strings, type Locale } from '../i18n/strings';

interface Props {
  locale: Locale;
  /** Path of this page below the edition root, e.g. 'investigation/'. Empty for the report itself. */
  slug?: string;
  title?: string;
  description?: string;
  /** Running-head sections on this page (ids from i18n/chrome). Defaults to every section. */
  entries?: string[];
}
const { locale, slug = '', entries } = Astro.props;
const t = strings[locale];
const pageTitle = Astro.props.title ?? t.htmlTitle;
const pageDescription = Astro.props.description ?? t.description;
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site);
const enUrl = new URL(`${base}${slug}`, Astro.site);
const esUrl = new URL(`${base}es/${slug}`, Astro.site);
const ogImage = new URL(`${base}og/cover-${locale}.jpg`, Astro.site);
const ogAlt = locale === 'en'
  ? 'Cover of “Sergio González, Inc. — Annual Report 2026”: a security-printed report on a dark desk, with a red Audited seal.'
  : 'Portada de “Sergio González, Inc. — Informe Anual 2026”: un informe con impresión de seguridad sobre un escritorio oscuro, con un sello rojo de Auditado.';

// Structured data: who this page is about, in the vocabulary search engines read.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  url: canonical.href,
  name: pageTitle,
  inLanguage: locale === 'en' ? 'en' : 'es-CO',
  image: ogImage.href,
  mainEntity: {
    '@type': 'Person',
    name: 'Sergio Andrés González Mateus',
    alternateName: 'Sergio González',
    description: t.description,
    address: { '@type': 'PostalAddress', addressLocality: 'Bogotá', addressCountry: 'CO' },
    alumniOf: [
      { '@type': 'CollegeOrUniversity', name: 'Universidad de los Andes' },
      { '@type': 'CollegeOrUniversity', name: 'Universidad Politécnica de Madrid' },
    ],
    knowsAbout: ['Machine learning', 'Artificial intelligence', 'Cybersecurity', 'Compliance', 'Risk', 'Data engineering', 'Business intelligence'],
    knowsLanguage: ['es', 'en'],
    sameAs: ['https://www.linkedin.com/in/sergonm/', 'https://github.com/SergonM'],
  },
};
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content="Sergio Andrés González Mateus" />
    <meta name="theme-color" content="#0f1a14" />
    <meta name="color-scheme" content="light" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    <link rel="sitemap" href={`${base}sitemap.xml`} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={t.company} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'en' ? 'en_US' : 'es_CO'} />
    <meta property="og:locale:alternate" content={locale === 'en' ? 'es_CO' : 'en_US'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta property="profile:first_name" content="Sergio" />
    <meta property="profile:last_name" content="González Mateus" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
          d.classList.add('motion-pending');
          setTimeout(function () { d.classList.remove('motion-pending'); }, 2500);
        }
      })();
    </script>
  </head>
  <body id="top">
    <a class="skip" href="#main">{t.skip}</a>
    <RunningHead locale={locale} entries={entries} slug={slug} />
    <slot />
    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
